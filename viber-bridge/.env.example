# Copy to .env (chmod 600). Never commit .env.

# --- Network (compose) ---
# Hub WireGuard address: API and noVNC are published only here.
WG_BIND_IP=10.77.0.1
VIBER_BRIDGE_PORT=8101
VIBER_NOVNC_PORT=6080

# --- Build ---
# sha256 of viber.deb you approved: curl -fsSL https://download.cdn.viber.com/cdn/desktop/Linux/viber.deb | sha256sum
VIBER_DEB_SHA256=

# --- Secrets ---
# Shared with Odoo (X-Bridge-Secret, both directions). Generate: openssl rand -hex 32
BRIDGE_SECRET=
# noVNC password for QR login (x11vnc uses only the first 8 characters).
VNC_PASSWORD=

# --- Odoo ---
# Odoo reachable over WireGuard; callbacks go to $ODOO_URL/messenger/bridge/viber/{incoming,status}
ODOO_URL=http://10.77.0.2:8069
ODOO_TIMEOUT=15
CALLBACK_STALE_AFTER=600

# --- Sending ---
# Keep false until target-chat verification is implemented and tested (see README).
VIBER_SEND_ENABLED=false
SEND_DELAY_MIN=4
SEND_DELAY_MAX=10
DAILY_LIMIT_TOTAL=150
DAILY_LIMIT_NEW_CONTACTS=20
SEND_CONFIRM_TIMEOUT=30

# --- Viber Desktop ---
# Account dir name under ~/.ViberPC (digits). Empty = autodetect single profile.
VIBER_ACCOUNT=
VIBER_OPEN_CMD=xdg-open
# Check with: xprop WM_CLASS (click on Viber window via noVNC)
VIBER_WINDOW_CLASS=ViberPC
UI_STEP_DELAY=2
WATCH_INTERVAL=3
SCREEN_GEOMETRY=1280x800x24
# QtWebEngine sandbox may fail under Docker seccomp; enable only if Viber does not start.
# QTWEBENGINE_DISABLE_SANDBOX=1

# --- Misc ---
DEBUG_RETENTION_DAYS=7
LOG_LEVEL=INFO
