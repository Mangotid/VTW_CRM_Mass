# Copy to .env (chmod 600). Never commit .env.

# --- Network (compose) ---
WG_BIND_IP=10.77.0.1
WA_ADAPTER_PORT=8103

# --- Evolution API (internal only) ---
# Generate: openssl rand -hex 32  (each value separately)
EVOLUTION_API_KEY=
EVOLUTION_DB_PASSWORD=
EVOLUTION_INSTANCE=pdm
# Evolution -> adapter webhook header X-Webhook-Secret (>= 32 chars)
WEBHOOK_SECRET=
# Optional: number for login.py (otherwise it asks)
WA_PHONE=

# --- Secrets ---
# Shared with Odoo (X-Bridge-Secret, both directions). Generate: openssl rand -hex 32
BRIDGE_SECRET=

# --- Odoo ---
ODOO_URL=http://10.77.0.2:8069
ODOO_TIMEOUT=15
CALLBACK_STALE_AFTER=600

# --- Sending ---
SEND_ENABLED=true
SEND_DELAY_MIN=4
SEND_DELAY_MAX=10
DAILY_LIMIT_TOTAL=150
# WhatsApp bans accounts that message many strangers: keep this low.
DAILY_LIMIT_NEW_CONTACTS=20

# --- Adapter ---
WA_STATE_INTERVAL=30
# Incoming older than this (hours) is dropped: offline catch-up after linking must not flood Odoo.
WA_INCOMING_MAX_AGE_HOURS=24
LOG_LEVEL=INFO
