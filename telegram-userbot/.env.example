# Copy to .env (chmod 600). Never commit .env.

# --- Network (compose) ---
WG_BIND_IP=10.77.0.1
TG_BRIDGE_PORT=8102

# --- Telegram API (my.telegram.org → API development tools, logged in with the corporate number) ---
TG_API_ID=
TG_API_HASH=
# Optional: phone for login.py (otherwise it asks)
TG_PHONE=
# Shown in Telegram → Settings → Devices
TG_DEVICE_MODEL=PDM Messenger Hub
# Name prefix for contacts imported to resolve phone numbers: "PDM +380..."
TG_CONTACT_LABEL=PDM
TG_HEALTH_INTERVAL=60
# Flood waits up to N seconds are slept through by Telethon; longer ones defer the message.
TG_FLOOD_SLEEP_THRESHOLD=30

# --- Secrets ---
# Shared with Odoo (X-Bridge-Secret, both directions). Generate: openssl rand -hex 32
BRIDGE_SECRET=

# --- Odoo ---
ODOO_URL=http://10.77.0.2:8069
ODOO_TIMEOUT=15
CALLBACK_STALE_AFTER=600

# --- Sending ---
SEND_ENABLED=true
SEND_DELAY_MIN=4
SEND_DELAY_MAX=10
DAILY_LIMIT_TOTAL=150
# Telegram is strict about messages to people who never wrote to the account (PeerFlood).
DAILY_LIMIT_NEW_CONTACTS=20

LOG_LEVEL=INFO
